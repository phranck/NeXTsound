Feedback endpoint fixes for UAC2 devices in TinyUSB 0.21.0 (dae3f9a366bfcddbf9dcf1b48d7500286a849539)

Full-speed format (issue 43). TinyUSB 0.21.0 formats the feedback endpoint value by UAC version alone: UAC1 gets 10.14 in three bytes, UAC2 gets 16.16 in four bytes regardless of bus speed. USB 2.0 section 5.12.4.2 assigns 10.14 in three bytes to every full-speed device, and macOS rejects any other packet size on a full-speed feedback endpoint. TinyUSB 0.18 offered CFG_TUD_AUDIO_ENABLE_FEEDBACK_FORMAT_CORRECTION for exactly this, and the option disappeared with the UAC1 rework. The patch restores it: a full-speed UAC2 device sends 10.14 in three bytes when the option is set, and the default stays 16.16.

First packet (issue 61). audiod_set_interface() schedules a stream's first feedback packet while it opens the endpoints, before tud_audio_set_itf_cb() runs, and closing a stream clears the feedback state to 0. Every stream therefore starts with a feedback of 0 samples per frame, which a host that sizes its packets from it turns into empty packets. The patch schedules the first packet after the callback and the feedback parameters, so the value the application sets there goes out.

Scripts/bootstrap-firmware.sh applies the patch after the pinned checkout.

diff --git a/src/class/audio/audio_device.c b/src/class/audio/audio_device.c
index 995bf8a3e..8336f8138 100644
--- a/src/class/audio/audio_device.c
+++ b/src/class/audio/audio_device.c
@@ -594,8 +594,13 @@ bool tud_audio_int_n_write(uint8_t func_id, const audio_interrupt_data_t *data)
 static inline bool audiod_fb_send(uint8_t func_id, bool is_isr) {
   audiod_function_t *audio = &_audiod_fct[func_id];
   uint8_t uac_version = tud_audio_n_version(func_id);
+  // Full speed carries feedback as 10.14 in three bytes (USB 2.0 5.12.4.2). UAC1 is full speed only;
+  // a full-speed UAC2 device gets the same format when CFG_TUD_AUDIO_ENABLE_FEEDBACK_FORMAT_CORRECTION
+  // is set, otherwise the 16.16 value goes out as-is in four bytes.
+  bool const format_10_14 = (uac_version == 1) ||
+                            (CFG_TUD_AUDIO_ENABLE_FEEDBACK_FORMAT_CORRECTION && TUSB_SPEED_FULL == tud_speed_get());
   // Format the feedback value
-  if (uac_version == 1) {
+  if (format_10_14) {
     uint8_t *fb = (uint8_t *) audio->fb_buf;
 
     // For FS format is 10.14
@@ -607,7 +612,7 @@ static inline bool audiod_fb_send(uint8_t func_id, bool is_isr) {
     *audio->fb_buf = audio->feedback.value;
   }
 
-  return usbd_edpt_xfer(audio->rhport, audio->ep_fb, (uint8_t *) audio->fb_buf, uac_version == 1 ? 3 : 4, is_isr);
+  return usbd_edpt_xfer(audio->rhport, audio->ep_fb, (uint8_t *) audio->fb_buf, format_10_14 ? 3 : 4, is_isr);
 }
 
 uint32_t tud_audio_feedback_update(uint8_t func_id, uint32_t cycles) {
@@ -1230,8 +1235,7 @@ static bool audiod_set_interface(uint8_t rhport, tusb_control_request_t const *p
           if (is_feedback_ep) {
             audio->ep_fb = ep_addr;
             audio->feedback.frame_shift = desc_ep->bInterval - 1;
-            // Schedule first feedback transmit
-            audiod_fb_send(func_id, false);
+            // The first feedback transmit is scheduled after tud_audio_set_itf_cb() below.
           }
   #else
           (void) is_feedback_ep;
@@ -1253,6 +1257,12 @@ static bool audiod_set_interface(uint8_t rhport, tusb_control_request_t const *p
 #if CFG_TUD_AUDIO_ENABLE_FEEDBACK_EP
       // Prepare feedback computation parameters
       TU_VERIFY(audiod_fb_params_prepare(func_id, alt));
+
+      // Schedule the first feedback transmit only now, so the value set in tud_audio_set_itf_cb()
+      // goes out instead of the 0 left by clearing the feedback state when the endpoint closed.
+      if (audio->ep_fb != 0) {
+        audiod_fb_send(func_id, false);
+      }
 #endif// CFG_TUD_AUDIO_ENABLE_FEEDBACK_EP
 
       // We are done - abort loop
