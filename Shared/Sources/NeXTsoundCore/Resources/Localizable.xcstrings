{
  "sourceLanguage" : "en",
  "strings" : {
    "A datasheet origin needs at least one source URL." : {
      "comment" : "A description of an error that might occur when validating a driver.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Datenblattherkunft benötigt mindestens eine Quell-URL."
          }
        }
      }
    },
    "A different version of this driver model already exists." : {
      "comment" : "Error description when a driver model with the same ID already exists in the library.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es existiert bereits eine andere Version dieses Treibermodells."
          }
        }
      }
    },
    "Check the %@ value." : {
      "comment" : "A description of an error that might occur when validating a driver.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüfen Sie den Wert von %@."
          }
        }
      }
    },
    "Check the enclosure volume and its source." : {
      "comment" : "A description of an error that might occur when validating a profile.",
